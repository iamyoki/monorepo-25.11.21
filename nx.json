{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {},
  "release": {
    "projects": ["*"],
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": true
    },
    "conventionalCommits": {
      "types": {
        "feat": true,
        "fix": true,
        "chore": { "semverBump": "none" },
        "style": { "semverBump": "none" },
        "test": { "semverBump": "none" },
        "build": true,
        "ci": { "semverBump": "none" },
        "docs": { "semverBump": "none" },
        "perf": true,
        "refactor": true,
        "revert": true
      }
    }
  }
}
