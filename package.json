{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run -r build",
    "clean": "del-cli **/dist **/*.tsbuildinfo **/.eslintcache *.tgz",
    "commit": "node --import=tsx ./scripts/commit.ts",
    "dev": "pnpm run --parallel dev",
    "format": "prettier --write .",
    "lint": "eslint --cache",
    "prepare": "husky",
    "start": "pnpm --filter './apps/*' run --parallel start",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@nx/js": "^22.1.2",
    "@types/node": "^24.10.1",
    "@types/prompts": "^2.4.9",
    "@vitest/ui": "^4.0.0",
    "chalk": "^5.6.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "lint-staged": "^16.2.7",
    "nx": "22.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "prompts": "^2.4.2",
    "read-package-up": "^12.0.0",
    "simple-git": "^3.30.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
